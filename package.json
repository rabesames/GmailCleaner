{
  "name": "gmail-cleaner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client-side-only React SPA that talks to the Gmail REST API directly from the browser, stores message metadata in IndexedDB, and ranks senders by total email size with a one-click Move to Trash action.",
  "scripts": {
    "start": "vite --port 5500",
    "dev": "vite --port 5500",
    "build": "vite build",
    "preview": "vite preview --port 5500",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
